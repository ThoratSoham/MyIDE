{
  "name": "myide",
  "version": "0.1.0",
  "description": "MyIDE - free AI IDE for Windows, Mac and Linux",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.main.json && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dist": "npm run build && electron-builder",
    "bench": "npm run build:main && node scripts/bench.mjs",
    "test:unit": "node --test --test-force-exit tests/*.test.js",
    "test:e2e": "node tests/e2e-chat.mjs",
    "pretest": "npm run build:main && npm run build:renderer",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "build": {
    "appId": "com.myide.app",
    "productName": "MyIDE",
    "asarUnpack": [
      "**/node_modules/@homebridge/node-pty-prebuilt-multiarch/**",
      "**/node_modules/node-pty/**"
    ],
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.12.0",
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-log": "^5.2.4",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.68.0",
    "monaco-editor": "^0.52.2",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.16"
  }
}
