      "variant": "A",
      "html": "<header class=\"nav\" aria-label=\"Primary navigation\">\n  <nav class=\"nav__inner container\">\n    <a class=\"nav__brand\" href=\"#main\">{{brand}}</a>\n    <ul class=\"nav__links\">\n      {{#items}}<li><a class=\"nav__link\" href=\"{{href}}\">{{label}}</a></li>{{/items}}\n    </ul>\n    <a class=\"btn btn--primary\" href=\"{{ctaHref}}\">{{ctaLabel}}</a>\n  </nav>\n</header>"
