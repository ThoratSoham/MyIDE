      "html": "<footer class=\"footer\" aria-label=\"Site footer\">\n  <div class=\"container footer__cols\">\n    <div class=\"footer__col\">\n      <span class=\"nav__brand\">{{brand}}</span>\n      <p class=\"small muted\">{{tagline}}</p>\n      <p class=\"small muted\">{{address}}</p>\n    </div>\n    {{#columns}}<div class=\"footer__col\">\n      <h2 class=\"h4\">{{title}}</h2>\n      {{#links}}<a href=\"{{href}}\">{{label}}</a>{{/links}}\n    </div>{{/columns}}\n    <div class=\"footer__col\">\n      <h2 class=\"h4\">Contact</h2>\n      <a href=\"mailto:{{email}}\">{{email}}</a>\n      <a href=\"tel:{{phone}}\">{{phone}}</a>\n    </div>\n  </div>\n  <div class=\"container\">\n    <p class=\"small muted\">{{copyright}}</p>\n  </div>\n</footer>"
    }
  ]
}
